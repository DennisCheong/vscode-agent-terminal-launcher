{
  "name": "agent-terminal-launcher",
  "displayName": "Agent Terminal Launcher",
  "description": "One-click button that opens a right-side terminal and runs a configurable agent CLI.",
  "version": "1.0.1",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/DennisCheong/vscode-agent-terminal-launcher.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:agentTerminal.start",
    "onCommand:agentTerminal.manageProfiles",
    "onCommand:agentTerminal.refSelection",
    "onCommand:agentTerminal.refFile"
  ],
  "main": "./extension.js",
  "scripts": {
    "build": "vsce package --out dist/agent-terminal-launcher.vsix",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "agentTerminal.start",
        "title": "Start Agent Terminal",
        "category": "Agent",
        "icon": "$(terminal)"
      },
      {
        "command": "agentTerminal.manageProfiles",
        "title": "Open Agent Terminal Settings",
        "category": "Agent",
        "icon": "$(edit)"
      },
      {
        "command": "agentTerminal.refSelection",
        "title": "Reference Current File or Selection",
        "category": "Agent",
        "icon": "$(link)"
      },
      {
        "command": "agentTerminal.refFile",
        "title": "Reference Current File",
        "category": "Agent",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "agentTerminal.start",
          "when": "resourceScheme == 'file' || resourceScheme == 'untitled' || resourceScheme == 'vscode-terminal'",
          "group": "navigation@0"
        },
        {
          "command": "agentTerminal.manageProfiles",
          "when": "resourceScheme == 'file' || resourceScheme == 'untitled' || resourceScheme == 'vscode-terminal'",
          "group": "navigation@1"
        },
        {
          "command": "agentTerminal.refSelection",
          "when": "resourceScheme == 'file'",
          "group": "navigation@2"
        }
      ]
    }
  }
}
